  "crow_answers_text": {
    "t2-write": "```cpp\n// lru_cache.hpp\n#ifndef LRU_CACHE_HPP\n#define LRU_CACHE_HPP\n\n#include <unordered_map>\n#include <list>\n#include <optional>\n#include <cstddef>\n#include <stdexcept>\n\nnamespace cache {\n\ntemplate<class K, class V>\nclass LRUCache {\npublic:\n    using KeyType = K;\n    using ValueType = V;\n\n    explicit LRUCache(std::size_t capacity)\n        : capacity_(capacity)\n    {\n        if (capacity_ == 0) {\n            throw std::invalid_argument(\"LRUCache capacity must be greater than zero\");\n        }\n    }\n\n    // Retrieve a value by key. Marks the entry as most-recently-used.\n    // Returns std::nullopt if the key is not present.\n    std::optional<V> get(const K& key) {\n        auto it = map_.find(key);\n        if (it == map_.end()) {\n            return std::nullopt;\n        }\n\n        // Move the accessed element to the front of the list (most recently used).\n        // splice does not invalidate iterators or references to elements in either container,\n        // so we can safely move the node within the same list.\n        lru_list_.splice(lru_list_.begin(), lru_list_, it->second.second);\n\n        return it->second.first;\n    }\n\n    // Peek at a value without changing its recency status.\n    // Useful for testing and inspection.\n    std::optional<V> peek(const K& key) const {\n        auto it = map_.find(key);\n        if (it == map_.end()) {\n            return std::nullopt;\n        }\n        return it->second.first;\n    }\n\n    // Insert or update a key-value pair.\n    // If the key exists, updates the value and marks it as most-recently-used.\n    // If the cache is at capacity, evicts the least-recently-used entry before inserting.\n    void put(const K& key, const V& value) {\n        auto it = map_.find(key);\n\n        if (it != map_.end()) {\n            // Key already exists: update the stored value and promote to MRU.\n            it->second.first = value;\n            lru_list_.splice(lru_list_.begin(), lru_list_, it->second.second);\n        } else {\n            // New key: check if we need to evict.\n            if (map_.size() >= capacity_) {\n                // Evict the least-recently-used entry.\n                // The LRU item is at the back of the list.\n                if (!lru_list_.empty()) {\n                    auto last_it = std::prev(lru_list_.end());\n                    K old_key = *last_it;\n\n                    // Remove from the hash map first, then erase from the list.\n                    map_.erase(old_key);\n                    lru_list_.pop_back();\n                }\n            }\n\n            // Push the new key to the front (MRU position) and store iterator into map.\n            lru_list_.push_front(key);\n            map_[key] = {value, lru_list_.begin()};\n        }\n    }\n\n    // Erase a key from the cache.\n    // Returns true if the key was found and removed, false otherwise.\n    bool erase(const K& key) {\n        auto it = map_.find(key);\n        if (it == map_.end()) {\n            return false;\n        }\n\n        // Erase from the linked list using the stored iterator.\n        lru_list_.erase(it->second.second);\n        map_.erase(it);\n        return true;\n    }\n\n    // Current number of entries in the cache.\n    std::size_t size() const noexcept {\n        return map_.size();\n    }\n\n    // Maximum capacity of the cache.\n    std::size_t capacity() const noexcept {\n        return capacity_;\n    }\n\n    // Clear all entries from the cache.\n    void clear() noexcept {\n        map_.clear();\n        lru_list_.clear();\n    }\n\nprivate:\n    std::size_t capacity_;\n\n    // Hash map: key -> (value, iterator into lru_list_)\n    // Using an unordered_map for O(1) average lookups.\n    std::unordered_map<K, std::pair<V, typename std::list<K>::iterator>> map_;\n\n    // Doubly-linked list storing keys in order of usage.\n    // Front = Most Recently Used, Back = Least Recently Used.\n    std::list<K> lru_list_;\n};\n\n} // namespace cache\n\n#endif // LRU_CACHE_HPP\n```"
