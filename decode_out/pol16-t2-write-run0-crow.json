  "crow_answers_text": {
    "t2-write": "```cpp\n// lru_cache.hpp\n// A fixed-capacity LRU (Least Recently Used) cache.\n//\n// Design decisions:\n// - We use std::list for theO(1) splice (move-to-front) and erase, and\n//   std::unordered_map for O(1) average lookup. The list stores pairs of\n//   (K, V) so that when we evict the LRU entry we can also remove the\n//   corresponding key from the map.\n// - The list is ordered with the most-recently-used (MRU) entry at the front\n//   and the least-recently-used (LRU) entry at the back.\n// - get() and put() both promote the accessed/updated key to MRU position.\n// - peek() does NOT promote, allowing tests to verify recency without side effects.\n// - Capacity is fixed at construction; 0 is rejected because an LRU cache with\n//   no room cannot store any entry, which is a degenerate/invalid use case.\n// - We store the key inside the list node so that eviction can find the key\n//   to erase from the map without needing a reverse lookup.\n\n#ifndef LRU_CACHE_HPP\n#define LRU_CACHE_HPP\n\n#include <unordered_map>\n#include <list>\n#include <optional>\n#include <cstddef>\n#include <stdexcept>\n#include <utility>\n\ntemplate <class K, class V>\nclass LruCache {\npublic:\n    // The list stores (key, value) pairs. The map maps key -> iterator into the list.\n    using ListType = std::list<std::pair<K, V>>;\n    using MapType  = std::unordered_map<K, typename ListType::iterator>;\n\n    // Construct with a fixed capacity. Throws std::invalid_argument if capacity == 0.\n    explicit LruCache(std::size_t capacity)\n        : capacity_(capacity)\n    {\n        if (capacity_ == 0) {\n            throw std::invalid_argument(\"LruCache: capacity must be greater than 0\");\n        }\n    }\n\n    // Retrieve a value by key. Returns std::nullopt if the key is not present.\n    // On success, the entry is promoted to most-recently-used (front of list).\n    std::optional<V> get(const K& key) {\n        auto it = map_.find(key);\n        if (it == map_.end()) {\n            return std::nullopt;\n        }\n        // Promote to MRU: splice the node to the front of the list.\n        // splice does not invalidate iterators, so the map entry remains valid.\n        list_.splice(list_.begin(), list_, it->second);\n        return it->second->second;\n    }\n\n    // Insert or update a key-value pair. If the key already exists, its value is\n    // updated and the entry is promoted to MRU. If the cache is full, the LRU\n    // entry (back of list) is evicted before insertion.\n    void put(const K& key, const V& value) {\n        auto it = map_.find(key);\n        if (it != map_.end()) {\n            // Key exists: update value and promote to MRU.\n            it->second->second = value;\n            list_.splice(list_.begin(), list_, it->second);\n            return;\n        }\n\n        // Key does not exist: check if we need to evict.\n        if (map_.size() >= capacity_) {\n            // Evict the LRU entry (back of the list).\n            auto lru_it = std::prev(list_.end());\n            const K& lru_key = lru_it->first;\n            map_.erase(lru_key);\n            list_.pop_back();\n        }\n\n        // Insert new entry at the front (MRU position).\n        list_.emplace_front(key, value);\n        map_.emplace(key, list_.begin());\n    }\n\n    // Remove a key from the cache. Returns true if the key was present and removed.\n    bool erase(const K& key) {\n        auto it = map_.find(key);\n        if (it == map_.end()) {\n            return false;\n        }\n        // Erase the list node first, then the map entry.\n        list_.erase(it->second);\n        map_.erase(it);\n        return true;\n    }\n\n    // Peek at a value without changing its recency. Returns std::nullopt if absent.\n    std::optional<V> peek(const K& key) const {\n        auto it = map_.find(key);\n        if (it == map_.end()) {\n            return std::nullopt;\n        }\n        return it->second->second;\n\n    }\n\n    // Number of entries currently in the cache.\n    std::size_t size() const noexcept {\n        return map_.size();\n    }\n\n    // The fixed capacity of the cache.\n    std::size_t capacity() const noexcept {\n        return capacity_;\n    }\n\n    // Remove all entries from the cache.\n    void clear() {\n        list_.clear();\n        map_.clear();\n    }\n\nprivate:\n    std::size_t capacity_;\n    ListType    list_;\n    MapType     map_;\n};\n\n#endif // LRU_CACHE_HPP\n```\n\n```cpp\n// lru_cache_test.cpp\n// Unit tests for LruCache using plain assert() calls.//\n// Compile with: g++ -std=c++17 -O2 -Wall -Wextra -pedantic lru_cache_test.cpp -o lru_cache_test\n\n#include \"lru_cache.hpp\"\n#include <cassert>\n#include <string>\n#include <iostream>\n\nint main() {\n    // ------------------------------------------------------------------\n"
