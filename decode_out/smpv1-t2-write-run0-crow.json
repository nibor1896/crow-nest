  "crow_answers_text": {
    "t2-write": "```cpp\n// lru_cache.hpp\n#ifndef LRU_CACHE_HPP\n#define LRU_CACHE_HPP\n\n#include <unordered_map>\n#include <list>\n#include <optional>\n#include <cstddef>\n#include <stdexcept>\n\ntemplate<class K, class V>\nclass LRUCache {\npublic:\n    // The list stores pairs of (key, value) so we can reconstruct the key when evicting.\n    using Entry = std::pair<K, V>;\n    using ListType = std::list<Entry>;\n    using Iterator = typename ListType::iterator;\n\nprivate:\n    std::size_t capacity_;\n    std::list<Entry> entries_; // Front = most recently used, back = least recently used\n    std::unordered_map<K, Iterator> lookup_;\n\npublic:\n    explicit LRUCache(std::size_t cap) : capacity_(cap) {\n        if (capacity_ == 0) {\n            throw std::invalid_argument(\"LRUCache capacity must be greater than zero\");\n        }\n    }\n\n    // Returns a copy of the value if present, and moves the entry to the front (MRU).\n    std::optional<V> get(const K& key) {\n        auto it = lookup_.find(key);\n        if (it == lookup_.end()) {\n            return std::nullopt;\n        }\n        // Move the entry to the front (most-recently-used position).\n        entries_.splice(entries_.begin(), entries_, it->second);\n        return std::optional<V>(it->second->second);\n    }\n\n    // Inserts or updates an entry. If full, evicts the LRU (back of list).\n    void put(const K& key, const V& value) {\n        auto it = lookup_.find(key);\n        if (it != lookup_.end()) {\n            // Update existing entry: move to front and update value.\n            it->second->second = value;\n            entries_.splice(entries_.begin(), entries_, it->second);\n        } else {\n            // Insert new entry at the front.\n            entries_.push_front(Entry{key, value});\n            auto new_it = entries_.begin();\n            lookup_[key] = new_it;\n\n            // If over capacity, evict the least-recently-used (back of list).\n            if (lookup_.size() > capacity_) {\n                auto last_it = std::prev(entries_.end());\n                const K& old_key = last_it->first;\n                lookup_.erase(old_key);\n                entries_.pop_back();\n            }\n        }\n    }\n\n    // Removes the entry for the given key. Returns true if removed.\n    bool erase(const K& key) {\n        auto it = lookup_.find(key);\n        if (it == lookup_.end()) {\n            return false;\n        }\n        // Erase from both structures.\n        entries_.erase(it->second);\n        lookup_.erase(it);\n        return true;\n    }\n\n    // Returns the number of entries currently stored.\n    std::size_t size() const noexcept {\n        return lookup_.size();\n    }\n\n    // Returns the maximum capacity.\n    std::size_t capacity() const noexcept {\n        return capacity_;\n    }\n\n    // Clears all entries.\n    void clear() {\n        entries_.clear();\n        lookup_.clear();\n    }\n\n    // Peeks at a key without changing its recency. Returns a copy of the value if found.\n    std::optional<V> peek(const K& key) const {\n        auto it = lookup_.find(key);\n        if (it == lookup_.end()) {\n            return std::nullopt;\n        }\n        return std::optional<V>(it->second->second);\n    }\n};\n\n#endif // LRU_CACHE_HPP\n\n\n// main.cpp\n#include \"lru_cache.hpp\"\n#include <cassert>\n#include <string>\n#include <iostream>\n\nint main() {\n    // Test 1: Basic eviction order.\n    {\n        LRUCache<std::string, int> cache(2);\n        cache.put(\"a\", 1);\n        cache.put(\"b\", 2);\n        // Cache: [b, a] (b is MRU, a is LRU)\n        assert(cache.size() == 2);\n        assert(cache.capacity() == 2);\n\n        // Access \"a\" -> makes it MRU. Now order: [a, b], b is LRU.\n        auto val_a = cache.get(\"a\");\n        assert(val_a.has_value() && val_a.value() == 1);\n\n        // Put \"c\" -> should evict \"b\" (the current LRU).\n        cache.put(\"c\", 3);\n        assert(cache.size() ==