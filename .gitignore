**/target*/
# python
.venv-oracle/
__pycache__/
# measurement artefacts and dumps
# measurement runs are never committed (E3, #43); only the gate inputs below stay tracked
decode_out/*
!decode_out/final4-t1-read-run0-crow.json
!decode_out/final4-t1b-read-lang-run0-crow.json
